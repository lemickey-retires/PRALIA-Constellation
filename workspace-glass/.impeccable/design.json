  "narrative": {
    "northStar": "Floating tools over a still universe",
    "overview": "Dark, green-neutral glass lets the existing golden universe still fill the window while compact tools float above it. The material belongs to the navigation rail, library, inspector and view dock; restrained type and clear selected states keep the controls readable.\n\nThis is a local sample-data UI preview. Its decorative refraction samples the bundled still, while native HTML retains interaction and accessibility. The original workspace UI and source component library remain separate and unchanged; this document describes the second version.",
    "keyCharacteristics": [
      "Full-viewport still with floating tools.",
      "Green-neutral translucency and soft rounded silhouettes.",
      "Compact Inter hierarchy and explicit selected states.",
      "Event-driven material updates and a solid fallback."
    ],
    "rules": [
      {
        "name": "The Legible Glass Rule",
        "body": "Place a dark translucent veil between refraction and foreground controls; material never replaces text contrast.",
        "section": "colors"
      },
      {
        "name": "The Quiet Hierarchy Rule",
        "body": "Use compact size and weight differences to organise controls; do not introduce a marketing display scale into the workspace.",
        "section": "typography"
      },
      {
        "name": "The Still Texture Rule",
        "body": "Refraction samples only the bundled still and redraws on scheduled interface changes; no continuous material render loop is part of this system.",
        "section": "elevation"
      },
      {
        "name": "The Native Foreground Rule",
        "body": "Keep semantic HTML controls above decorative, inert, aria-hidden material canvases.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve visible sample-content and static-scene disclosures.",
      "Do keep the rail, search and bottom dock reachable when panels collapse.",
      "Do use the solid material mode and opaque fallback when refraction is unavailable.",
      "Do retain keyboard focus, selected states and native control semantics."
    ],
    "donts": [
      "Don't present the still or sample records as a live graph or connected app.",
      "Don't extend refraction to every small control; reserve it for the implemented structural surfaces and Save action.",
      "Don't add a continuously running scene or material animation.",
      "Don't modify the original UI or read-only source library to extend this version."
    ]
  },
