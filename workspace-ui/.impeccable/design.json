  "narrative": {
    "overview": "The surrounding interface uses the owner's Linear palette and Obsidian-style workspace structure. Compact navigation, sources and an inspector support the central scene. Tonal surfaces, grey text and scarce lavender establish hierarchy.\n\nThis record describes the implemented HTML and CSS. System UI sans is intentional in this Operate surface. The dramatic still belongs to the scene; its warm colour does not become a second interface accent.",
    "northStar": "A quiet, precise workspace",
    "rules": [
      {
        "name": "The Scarce Accent Rule",
        "body": "Use lavender for meaningful interface state and action; keep large working surfaces neutral.",
        "section": "colors"
      },
      {
        "name": "The Working Type Rule",
        "body": "Use sentence-case labels and compact headings; derive hierarchy from weight, spacing and tone before increasing size.",
        "section": "typography"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Establish depth with the existing surface ladder and hairline edges, retaining the flat workspace.",
        "section": "elevation"
      }
    ],
    "keyCharacteristics": [
      "Near-black canvas and charcoal working surfaces.",
      "Compact sentence-case controls.",
      "Lavender for action, selection and keyboard focus.",
      "Collapsible panels around a continuous central view."
    ],
    "donts": [
      "**Don't** turn warm scene imagery into a second interface accent.",
      "**Don't** import the reference's marketing display scale into this workspace.",
      "**Don't** add decorative shadows or atmospheric gradients to controls.",
      "**Don't** represent saved preview settings as proof of a working graph engine."
    ],
    "dos": [
      "**Do** keep large working surfaces neutral and reserve lavender for action and state.",
      "**Do** retain keyboard focus and accessible names on icon controls.",
      "**Do** use compact sentence-case labels and internally scrolling panels.",
      "**Do** distinguish preview content from connected application state."
    ]
  }
